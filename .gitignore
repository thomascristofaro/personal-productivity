# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files — .env.example is committed and documents the variable names
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma client, regenerated by postinstall
/lib/generated/prisma

# agent skill mirrors — the real files live in .agents/skills
/.claude/skills
/.windsurf

# the one-off import of the owners' handwritten menu history. It is their
# personal data — what they ate, and which evenings they were away from home —
# and this repository is public
/prisma/import

# snapshots and traces the playwright MCP server drops while driving the app
# through a manual checklist — output of a verification, never a source
/.playwright-mcp

# Dev server logs, written when the server is started detached for a browser check.
dev-*.log
