# Copy to .env and fill in. Never commit .env.
# In production these live in Vercel Environment Variables.

# The database. Locally this is the container in docker-compose.yml, and the two
# values are the same string: there is no pooler in front of it. Start it with
# `docker compose up -d`, then `pnpm db:deploy` and `pnpm db:seed`.
#
# In production they differ and both live in Vercel Environment Variables:
# DATABASE_URL is Neon's pooled connection, used by the application at runtime,
# and DIRECT_URL is the direct one, used by migrations — a migration cannot run
# through the pooler. Never put the production values here. A local .env that
# can reach production is one distracted command away from an accident.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/personal_productivity
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/personal_productivity

# The key, from the Google Cloud Agent Platform (console.cloud.google.com,
# Model Garden) — this project uses Cloud rather than AI Studio. Used only by
# lib/services/llm.ts, which hands it to the provider: the SDK's own default
# name is GOOGLE_GENERATIVE_AI_API_KEY and this is deliberately not that.
GOOGLE_AI_API_KEY=
# Which Google endpoint that key belongs to. The two are NOT interchangeable.
#   https://aiplatform.googleapis.com/v1/publishers/google   Cloud Agent Platform
#   https://generativelanguage.googleapis.com/v1beta         AI Studio
# An Agent Platform key is refused by the AI Studio host with
# API_KEY_SERVICE_BLOCKED, and the SDK targets that host unless told otherwise.
# Probe a key with `pwsh scripts/llm-probe.ps1` before changing this.
GOOGLE_AI_BASE_URL=https://aiplatform.googleapis.com/v1/publishers/google
# The model menu generation runs on, so the next one is an environment change
# rather than a deploy.
GEMINI_MODEL=gemini-3.7-flash

# The origin this app is served from, no trailing slash. http://localhost:3000
# in development, the real domain in production. It must match the redirect URI
# registered with Google: better-auth would otherwise derive the origin from
# proxy headers, and an OAuth callback is the worst place to find that out.
APP_URL=

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Google OAuth client, from console.cloud.google.com. Authorised redirect URIs
# must include http://localhost:3000/api/auth/callback/google and the same path
# on the production origin. Consent screen in Testing, with both addresses below
# as test users — a private app of two people needs no Google verification.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The two users the seed creates, and therefore the only two people who can ever
# sign in: sign-up is disabled, so an address that is not seeded is refused.
# Seeding twice with different addresses leaves four users — the seed upserts on
# email. Change these before the first seed, not after.
OWNER_EMAIL=
PARTNER_EMAIL=
