# Copy to .env and fill in. Never commit .env.
# In production these live in Vercel Environment Variables.

# Neon pooled connection — used by the application at runtime.
DATABASE_URL=

# Neon direct connection — used by Prisma migrations. Not interchangeable
# with DATABASE_URL: migrations cannot run through the pooler.
DIRECT_URL=

# Anthropic Messages API. Used only by lib/services/llm.ts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
